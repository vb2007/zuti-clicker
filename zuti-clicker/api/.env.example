IP=localhost
PORT=2710

DATABASE_URL="mysql://user:password@ip:port/dbName"
SHADOW_DATABASE_URL="mysql://user:password@ip:port/shadowDbName"

DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="dbName"
DATABASE_HOST="ip"
DATABASE_PORT=port

CRYPTO_SECRET_KEY=your_secret_key_here

# Anti-cheat mode: enforce (default) | monitor | off. "off" and "monitor" are
# for local development only — set to "off" to make requests from a raw API
# client without the save plausibility envelope or statistical detection
# rejecting them. Ignored (forced to "enforce") whenever NODE_ENV=production.
ANTICHEAT_MODE=enforce