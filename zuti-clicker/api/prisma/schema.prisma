// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  email           String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  authentication  Authentication?
  gameSave        GameSave?
  settings        UserSettings?
  antiCheatState  AntiCheatState?
  antiCheatEvents AntiCheatEvent[]
}

model Authentication {
  id           Int    @id @default(autoincrement())
  userId       Int    @unique
  user         User   @relation(fields: [userId], references: [id])
  password     String
  salt         String
  sessionToken String
}

model GameSave {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique
  user              User            @relation(fields: [userId], references: [id])
  tokens            Float           @default(0)
  totalTokensEarned Float           @default(0)
  totalClicks       Int             @default(0)
  elapsedSeconds    Float           @default(0)
  phdCount          Int             @default(0)
  prestigeCount     Int             @default(0)
  runTokensEarned   Float           @default(0)
  runClicks         Int             @default(0)
  runSeconds        Float           @default(0)
  // Booster anti-cheat state (see ActiveBooster below): the earliest instant
  // at which the next POST /boosters/claim may succeed. Defaulting to "now"
  // makes every pre-existing row immediately claimable, which is correct.
  boostersCollected Int             @default(0)
  nextBoosterAt     DateTime        @default(now())
  savedAt           DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  units             UnitSave[]
  upgrades          UpgradeSave[]
  activeBoosters    ActiveBooster[]

  // Support ORDER BY ... DESC LIMIT queries for each leaderboard metric.
  @@index([totalTokensEarned])
  @@index([totalClicks])
  @@index([phdCount])
  @@index([elapsedSeconds])
}

model UnitSave {
  id         Int      @id @default(autoincrement())
  gameSaveId Int
  gameSave   GameSave @relation(fields: [gameSaveId], references: [id], onDelete: Cascade)
  unitId     String   @db.VarChar(32)
  owned      Int      @default(0)

  @@unique([gameSaveId, unitId])
}

// One-time click-power purchases (flat/multiplier/synergy/crit/booster
// families — see frontend/src/utils/gameConstants.ts). Unlike UnitSave,
// there is no `owned` count: presence of a row means the upgrade is bought.
// Reset (deleted wholesale) on prestige, same as UnitSave.
model UpgradeSave {
  id         Int      @id @default(autoincrement())
  gameSaveId Int
  gameSave   GameSave @relation(fields: [gameSaveId], references: [id], onDelete: Cascade)
  upgradeId  String   @db.VarChar(32)

  @@unique([gameSaveId, upgradeId])
}

// Server-issued, server-timed booster buffs (see POST /boosters/claim). Never
// written by PUT /save — the client cannot assert or extend a buff, only the
// claim endpoint (rate-limited by GameSave.nextBoosterAt) can create one.
// A second claim of an already-active type refreshes expiresAt in place.
model ActiveBooster {
  id         Int      @id @default(autoincrement())
  gameSaveId Int
  gameSave   GameSave @relation(fields: [gameSaveId], references: [id], onDelete: Cascade)
  boosterId  String   @db.VarChar(32)
  expiresAt  DateTime

  @@unique([gameSaveId, boosterId])
}

// Per-account strike/restriction state for the anti-cheat system (see the
// plan in docs/developer/final.md's "Anti-cheat modell" section). Created
// lazily on a user's first soft clamp or strike — most accounts never get a
// row here at all. `restrictedUntil` is the single gate every write-capable
// endpoint checks; NULL (not "in the past") means "never restricted, or the
// restriction has been consumed" so a clean account's common-case check is a
// cheap NULL test rather than a timestamp comparison.
model AntiCheatState {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strikeCount      Int       @default(0)
  restrictedUntil  DateTime?
  lastStrikeAt     DateTime?
  lastStrikeReason String?   @db.VarChar(64)
  // Anchors the "30 consecutive clean days" strike-decay window — reset to
  // now() on every new strike, left alone otherwise.
  lastCleanAt      DateTime  @default(now())
  suspicionScore   Int       @default(0)
  softClampCount   Int       @default(0)
  // Anchors the rolling 24h window recordSoftClamp counts materially-over-
  // bound clamps within — NULL until the first material clamp. Separate
  // from lastCleanAt: a clamp no longer resets the strike-decay anchor (a
  // clamp already neutralizes the gain; it must not also block decay).
  softClampWindowStartedAt DateTime?
  highRateWindows  Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

// Append-only audit log of every anti-cheat verdict, including ones
// suppressed by ANTICHEAT_MODE=monitor — this is what makes the detection
// thresholds tunable against real traffic instead of guessed at. Pruned by a
// cleanup script following the same dry-run/--apply/deletion-count-fuse
// pattern as scripts/cleanup-test-users.ts.
model AntiCheatEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  // e.g. "envelope_reject", "envelope_clamp", "statistical_verdict",
  // "hard_validation_reject" — see constants/antiCheat.ts for the full set.
  kind      String   @db.VarChar(32)
  // "info" (soft clamp, monitor-mode-only verdict) | "strike" (an actual
  // penalty was applied).
  severity  String   @db.VarChar(16)
  // The ANTICHEAT_MODE this event was evaluated under — lets a monitor-mode
  // tuning pass be told apart from a real enforced strike after the fact.
  mode      String   @db.VarChar(16)
  // Free-form JSON: which signals fired, envelope numbers, etc. Never game
  // save data itself — this table exists to tune/audit detection, not to
  // duplicate GameSave.
  detail    Json?
  enforced  Boolean  @default(false)

  @@index([userId, createdAt])
}

model UserSettings {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("dark") @db.VarChar(16)
  language             String   @default("en") @db.VarChar(16)
  autosaveEnabled      Boolean  @default(true)
  autosaveIntervalSecs Int      @default(30)
  prestigeCeremony     String   @default("full") @db.VarChar(16)
  hideFromLeaderboards Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}
