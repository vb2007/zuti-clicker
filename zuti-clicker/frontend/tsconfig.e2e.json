{
    "extends": "@tsconfig/node24/tsconfig.json",
    "include": [
        "e2e/**/*",
        "playwright.config.ts"
    ],
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "types": [
            "node"
        ],
        "lib": [
            "ES2023",
            "DOM"
        ],
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
    }
}
